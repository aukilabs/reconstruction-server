FROM --platform=$BUILDPLATFORM nvidia/cuda:12.8.1-base-ubuntu22.04 AS dependencies

ARG DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1

# Core system + build deps + runtime tools in ONE layer
RUN set -eux; \
    apt-get update; \
    apt-get install -y \
      wget \
      curl \
      vim \
      nano \
      less \
      jq \
      git \
      cmake \
      autoconf \
      automake \
      libtool \
      ninja-build \
      build-essential \
      libffi-dev \
      libboost-program-options-dev \
      libboost-filesystem-dev \
      libboost-graph-dev \
      libboost-system-dev \
      libeigen3-dev \
      libflann-dev \
      libopenimageio-dev \
      openimageio-tools \
      libopenexr-dev \
      libmetis-dev \
      libgtest-dev \
      libsqlite3-dev \
      libglew-dev \
      qtbase5-dev \
      libqt5opengl5-dev \
      libqt5svg5-dev \
      libcgal-dev \
      libsuitesparse-dev \
      python3-pip \
      python3-tk \
      python3-dev \
      libmkl-full-dev \
      libatomic1 \
      cuda-nvcc-12-8 \
      cuda-cudart-dev-12-8 \
      libcurand-dev-12-8 \
      libcublas-dev-12-8 \
      libcusolver-dev-12-8 \
      libcusparse-dev-12-8 \
      libnvjitlink-12-8 \
      libcudss0-dev-cuda-12 \
      libcudss0-static-cuda-12 \
      ssh \
      netcat-openbsd \
      ca-certificates \
      iproute2 \
      iputils-ping \
      bind9-dnsutils \
    ; \
    rm -rf /var/lib/apt/lists/*

# Ubuntu's OpenImageIO CMake config references an OpenCV include directory
# for its (unused by COLMAP) OpenCV integration; the dir must merely exist.
RUN mkdir -p /usr/include/opencv4

# Python toolchain + base Python deps
RUN set -eux; \
    python3 -m pip install --upgrade pip setuptools wheel; \
    python3 -m pip install "pybind11[global]==3.0.2" \
                           psutil gputil \
                           enlighten \
                           open3d \
                           trimesh \
                           alphashape


WORKDIR /tmp/build
RUN set -eux; \
    wget -q https://cmake.org/files/v3.27/cmake-3.27.9-linux-x86_64.tar.gz; \
    tar xzf cmake-3.27.9-linux-x86_64.tar.gz; \
    cd cmake-3.27.9-linux-x86_64; \
    cp -r bin /usr/; \
    cp -r share /usr/; \
    cp -r doc /usr/share/; \
    cp -r man /usr/share/; \
    cd /; \
    rm -rf /tmp/build/*

# glog
RUN set -eux; \
    cd /tmp/build; \
    git clone --depth 1 --branch v0.6.0 https://github.com/google/glog.git; \
    cd glog; \
    cmake -S . -B build -G "Unix Makefiles"; \
    cmake --build build --target install; \
    cd /; \
    rm -rf /tmp/build/*

# libglvnd
RUN set -eux; \
    cd /tmp/build; \
    git clone --depth 1 https://github.com/NVIDIA/libglvnd.git; \
    cd libglvnd; \
    ./autogen.sh; \
    ./configure; \
    make -j"$(nproc)"; \
    make install; \
    cd /; \
    rm -rf /tmp/build/*

# Workaround for runtime error when loading Intel MKL libraries
# See: https://bugs.launchpad.net/ubuntu/+source/intel-mkl/+bug/1947626
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libmkl_def.so:/usr/lib/x86_64-linux-gnu/libmkl_avx2.so:/usr/lib/x86_64-linux-gnu/libmkl_core.so:/usr/lib/x86_64-linux-gnu/libmkl_intel_lp64.so:/usr/lib/x86_64-linux-gnu/libmkl_intel_thread.so:/usr/lib/x86_64-linux-gnu/libiomp5.so


# apt's cuDSS packages (libcudss0-dev-cuda-12 / libcudss0-static-cuda-12) ship a CMake
# config (cudss-config.cmake) that expects its own headers/libs at paths *relative to
# itself* that don't match Debian's actual package layout (headers land at
# /usr/include/libcudss/12, but the config looks for them under
# /usr/lib/x86_64-linux-gnu/libcudss/12/../include etc.) -- create the symlink the
# config expects so `find_package(cudss CONFIG)` (used by Ceres below) succeeds.
RUN ln -sf /usr/include/libcudss/12 /usr/lib/x86_64-linux-gnu/libcudss/include

# cuDSS's shared libraries (/usr/lib/x86_64-linux-gnu/libcudss/12/) aren't on the
# default dynamic linker search path -- anything linking against Ceres's CUDA_SPARSE
# solver (pyceres, pycolmap) needs libcudss.so.0 findable at runtime, not just at
# link time.
RUN echo "/usr/lib/x86_64-linux-gnu/libcudss/12" > /etc/ld.so.conf.d/cudss.conf && ldconfig

# Ceres
# Pinned to a specific commit on master (no tagged release with cuDSS support exists
# yet -- 2.2.0 predates it entirely) because we need CUDA_SPARSE (GPU-accelerated
# SPARSE_SCHUR / SPARSE_NORMAL_CHOLESKY via cuDSS) for bundle adjustment: on this
# machine, Ceres's CPU sparse solver path routes through the broken system MKL above
# once a problem is large enough to need it, crashing bundle adjustment outright.
# cudss_DIR points cudss-config.cmake's `find_package(cudss CONFIG)` at the package
# installed above (its odd relative-path layout means CMAKE_PREFIX_PATH alone isn't
# enough -- see the symlink fix above too).
RUN set -eux; \
    cd /tmp/build; \
    git clone --recursive https://ceres-solver.googlesource.com/ceres-solver; \
    cd ceres-solver; \
    git checkout bac1127f9ef672405bd0d2d9c84e809ae89bd239; \
    mkdir build; \
    cd build; \
    cmake .. -GNinja \
      -DBUILD_TESTING=OFF \
      -DBUILD_EXAMPLES=OFF \
      -DLAPACK=ON \
      -DBLA_VENDOR=Intel10_64lp \
      -DUSE_CUDA=ON \
      -Dcudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/12/cmake/cudss; \
    ninja -j"$(nproc)"; \
    ninja install; \
    cd /; \
    rm -rf /tmp/build/*

# pyCeres
# Pinned to a commit past v2.6 (no tagged release yet) because it adds Python
# bindings for ceres::ProductManifold, required to parameterize COLMAP 4.x's
# combined 7-dim (quaternion + translation) pose parameter blocks.
RUN set -eux; \
    cd /tmp/build; \
    git clone https://github.com/cvg/pyceres.git; \
    cd pyceres; \
    git checkout 7339d790f364accf3e8f2204d2342a621516a359; \
    # Work around a pybind11>=3.0 strict-return-type-deduction build failure in
    # CostFunction::evaluate's lambda (two branches returning differently-typed
    # py::tuple specializations); not yet fixed upstream.
    sed -i \
      -e 's/return py::make_tuple(residuals, jacobians);/return py::tuple(py::make_tuple(residuals, jacobians));/' \
      -e 's/return py::make_tuple(py::none(), py::none());/return py::tuple(py::make_tuple(py::none(), py::none()));/' \
      _pyceres/core/cost_functions.h; \
    # pyceres's own bindings leave ceres::SparseLinearAlgebraLibraryType::CUDA_SPARSE
    # commented out (predates Ceres having cuDSS support); enable it so Python can
    # actually select the GPU sparse solver.
    sed -i \
      -e 's|//   .value("CUDA_SPARSE",|.value("CUDA_SPARSE",|' \
      -e 's|//           ceres::SparseLinearAlgebraLibraryType::CUDA_SPARSE)|ceres::SparseLinearAlgebraLibraryType::CUDA_SPARSE)|' \
      _pyceres/core/types.h; \
    CMAKE_ARGS="-Dcudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/12/cmake/cudss" \
      python3 -m pip install .; \
    cd /; \
    rm -rf /tmp/build/*

# COLMAP (+ its Python bindings)
RUN set -eux; \
    cd /tmp/build; \
    git clone --depth 1 --branch 4.1.0 https://github.com/colmap/colmap.git; \
    cd colmap; \
    mkdir build; \
    cd build; \
    cmake .. -GNinja \
      -DCUDA_ENABLED=ON \
      -DBLA_VENDOR=Intel10_64lp \
      -DCMAKE_CUDA_ARCHITECTURES="60;61;70;75;80;86;89;90;120" \
      -Dcudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/12/cmake/cudss; \
    ninja -j"$(nproc)"; \
    ninja install; \
    cd ..; \
    CMAKE_ARGS="-Dcudss_DIR=/usr/lib/x86_64-linux-gnu/libcudss/12/cmake/cudss -DCMAKE_CUDA_ARCHITECTURES=60;61;70;75;80;86;89;90;120 -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc" \
      python3 -m pip install .; \
    cd /; \
    rm -rf /tmp/build/*

# Hloc
RUN set -eux; \
    cd /tmp/build; \
    git clone --recursive https://github.com/aukilabs/Hierarchical-Localization.git; \
    cd Hierarchical-Localization; \
    git checkout --recurse-submodules 87b266cdb3a894455a9c889276f4e5d5913eb0eb; \
    pip install torch==2.9.1 torchvision==0.24.1 torchaudio==2.9.1 --index-url https://download.pytorch.org/whl/cu128; \
    python3 -m pip install .; \
    cd /; \
    rm -rf /tmp/build/*

# Draco
RUN set -eux; \
    cd /tmp/build; \
    git clone --depth 1 https://github.com/google/draco.git; \
    cd draco; \
    mkdir build; \
    cd build; \
    cmake .. -GNinja -DCMAKE_INSTALL_PREFIX=/usr/local; \
    ninja -j"$(nproc)"; \
    ninja install; \
    cd /; \
    rm -rf /tmp/build/*

# Ensure /usr/local/lib is searched
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf && ldconfig

# Final cleanup of build caches
RUN set -eux; \
    rm -rf /tmp/* /root/.cache || true
